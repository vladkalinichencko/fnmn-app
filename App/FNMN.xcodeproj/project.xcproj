        },
        { "path": "System/Library/Frameworks/WebKit.framework", "target-membership": [ "FNMN/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Sources",
      "children": [
        { "path": "Share/ShareViewController.swift", "index": true, "target-membership": [ "Share/compile-sources" ] },
        {
          "path": "Activity/ImportActivityAttributes.swift",
          "index": true,
          "target-membership": [
            "FNMN/compile-sources",
            "Activity/compile-sources",
          ],
        },
