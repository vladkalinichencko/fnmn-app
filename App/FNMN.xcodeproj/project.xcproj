        {
          "target": "FNMN",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "FNMNTests", "target-membership": [ "FNMNTests" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/FNMN.app", "id": "D6A411717639703C556A3A9B", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Share.appex", "id": "A1SHARE00000000000000004", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "FNMN/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/Activity.appex", "id": "A1ACT000000000000000014", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "FNMN/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/FNMNTests.xctest", "id": "A1TEST000000000000000001", "type": "wrapper.cfbundle", "index": false },
